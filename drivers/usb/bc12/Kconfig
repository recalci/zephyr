menuconfig USB_BC12
	bool "USB BC1.2 Drivers"
	help
	  Enable USB BC1.2 (battery charging detection) drivers.

if USB_BC12

config USB_BC12_INIT_PRIORITY
	int "USB BC1.2 driver init priority"
	default 81
	help
	  Initialization priority of the USB BC1.2 drivers in POST_KERNEL.

module = USB_BC12
module-str = usb_bc12
source "subsys/logging/Kconfig.template.log_config"

source "drivers/usb/bc12/Kconfig.pi3usb9201"
source "drivers/usb/bc12/Kconfig.ch32v"

endif # USB_BC12
